# Copy to .env (git-ignored) and load it with:
#   uv run --env-file .env codebase-qa ask "..."
# Command-line flags override these values. Uncomment one answer backend.

# --- Local Ollama (the built-in default; no key, nothing leaves the machine) ---
# Install Ollama, then pull a model, e.g. `ollama pull qwen2.5-coder:7b`.
# CODEBASE_QA_BASE_URL=http://localhost:11434/v1
# CODEBASE_QA_LLM_MODEL=qwen2.5-coder:7b
#
# Other local models (download size; RAM needed is roughly size + 2 GB):
#   qwen2.5-coder:7b        4.7 GB   code-tuned, answers without a reasoning phase
#   qwen3.5:4b              3.3-4 GB general, reasons first (slower)
#   nemotron-3.5-bolt:e4b   7.2-7.9 GB code-oriented, reasoning can be switched off
#   qwen3-coder:30b         19 GB    code-tuned MoE, ~3B active; needs 24 GB+ RAM
#   flint                   23 GB    coding MoE, ~2.5B active; needs 32 GB RAM
# On Apple Silicon, Ollama runs on the GPU through Metal; some models also
# publish MLX builds (e.g. qwen3.5:4b-mlx).

# --- llama.cpp server (alternative local runtime) ---
#   llama-server -hf <user>/<gguf-repo> --reasoning off
# CODEBASE_QA_BASE_URL=http://localhost:8080/v1
# CODEBASE_QA_LLM_MODEL=<any name; llama-server serves the loaded model>

# --- OpenRouter (hosted; sends retrieved code to a third party) ---
# CODEBASE_QA_API_KEY=
# CODEBASE_QA_BASE_URL=https://openrouter.ai/api/v1
# CODEBASE_QA_LLM_MODEL=recursive/flint-v1.0:free

# --- Anthropic (needs `uv sync --extra anthropic`) ---
# CODEBASE_QA_BACKEND=anthropic
# ANTHROPIC_API_KEY=
# CODEBASE_QA_LLM_MODEL=claude-opus-5-5

# --- Embeddings and device (used by index, search and ask) ---
# CODEBASE_QA_MODEL=minilm        # embedder preset or Hugging Face id
# CODEBASE_QA_DEVICE=mps          # cpu, cuda or mps; picked automatically if unset
# CODEBASE_QA_INDEX_DIR=          # default: <repo>/.codebase-qa
